{
  "info": {
    "_postman_id": "b1a2c3d4-e5f6-7890-1234-56789abcdef0",
    "name": "JeLeApp Test API",
    "description": "API документация для тестового задания. Включает автоматическое сохранение Bearer-токена после регистрации.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Регистрация нового юзера",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
              "    console.log(\"Токен успешно сохранен в переменные коллекции\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"hr.test@jeleapp.com\",\n    \"password\": \"secret12345\",\n    \"gender\": \"male\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/registration",
          "host": ["{{base_url}}"],
          "path": ["registration"]
        }
      },
      "response": []
    },
    {
      "name": "2. Получение данных профиля",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/profile",
          "host": ["{{base_url}}"],
          "path": ["profile"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://jeleapp-tt.onrender.com/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ]
}
